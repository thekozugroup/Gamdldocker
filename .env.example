# Gamdl configuration
#
# Copy to .env and edit. Every value here has a working default, so an empty
# .env is a valid .env — change only what you need.
#
# Most day-to-day settings (sync interval, quality, folder layout) live in the
# web UI instead, which writes them to config/settings.json. The UI wins when
# both are set, because that is where you last expressed an intent.

# ---------------------------------------------------------------------------
# Where things live on the host
# ---------------------------------------------------------------------------

# Host directory mounted as the music library. This is the one setting most
# people need to change.
#   Examples: /mnt/media/music · /volume1/music · D:\Music
MUSIC_HOST_PATH=./downloads

# ---------------------------------------------------------------------------
# Web UI access
# ---------------------------------------------------------------------------

# Which host interface the UI listens on. 0.0.0.0 means every interface —
# anyone who can reach this machine can reach the UI.
#
#   127.0.0.1     loopback only (use an SSH tunnel or a reverse proxy)
#   100.x.y.z     a Tailscale address
#   0.0.0.0       everything (the default)
BIND_HOST=0.0.0.0

# Host port for the UI. The container always serves on 3000.
WEBUI_PORT=3000

# Optional authentication. Leave blank for no login, which is fine on a private
# network and a bad idea on a public one. Set either a bearer token or a
# username/password pair — or both.
#
#   WEBUI_AUTH_TOKEN=$(openssl rand -hex 32)
WEBUI_AUTH_TOKEN=
WEBUI_USERNAME=
WEBUI_PASSWORD=

# ---------------------------------------------------------------------------
# Sync behaviour
# ---------------------------------------------------------------------------

# Seconds between checks. Minimum 60. Also settable in the UI.
FREQUENCY=3600

# Paths inside the container. Change these only if you also change the volume
# mappings in compose.yaml.
OUTPUT_LOCATION=/data/music
PLAYLIST_M3U_DIR=/data/music/playlists

# nm3u8dlre (fast, recommended) or ytdlp (fallback).
DOWNLOAD_MODE=nm3u8dlre

# Strip emoji and accents from filenames. Only needed for legacy SMB or exFAT
# shares that mishandle UTF-8 — everything modern handles them fine.
SAFE_FILENAMES=false

# ---------------------------------------------------------------------------
# Updates
# ---------------------------------------------------------------------------

# Apple changes its web player regularly, so an out-of-date gamdl eventually
# stops working. A failed upgrade rolls itself back automatically.
AUTO_UPDATE=true
AUTO_UPDATE_INTERVAL=86400
AUTO_UPDATE_GAMDL=true

# ---------------------------------------------------------------------------
# Build-time pins (only read by `docker compose build`)
# ---------------------------------------------------------------------------

# Empty means whatever gamdl is current when the image is built. Set a version
# (e.g. 3.8.5) to pin it. The runtime updater can still move past a pin.
GAMDL_VERSION=

# "pinned" installs a known-good N_m3u8DL-RE without contacting the GitHub API,
# so a build works behind a restrictive proxy. "latest" resolves the newest
# release at build time. A version number (e.g. 0.3.0) selects that release.
NM3U8DLRE_VERSION=pinned

# ---------------------------------------------------------------------------
# System
# ---------------------------------------------------------------------------

# Used for log timestamps and scheduling.
TZ=America/New_York

# Run the downloader as a specific user so downloaded files are not owned by
# root on the host. Find yours with `id -u` and `id -g`. Leave blank to keep the
# previous behaviour (running as root).
PUID=
PGID=

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
