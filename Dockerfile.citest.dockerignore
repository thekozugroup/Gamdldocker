node_modules
.github
.git
.gitignore
README.md
LICENSE
*.md
webui/node_modules
webui/.next

# Python downloader package — the root Dockerfile COPYs
# downloader/pyproject.toml and downloader/gamdl_sync explicitly, so those two
# must NOT be excluded here. Everything else under downloader/ is dev-only.
downloader/.venv
downloader/tests
downloader/.pytest_cache
downloader/.ruff_cache
downloader/*.egg-info
**/__pycache__

# Local sandbox / CI test artifacts — never part of the shipped image

# Secrets and live state must never enter a build context — the image is built
# with `context: .`, so anything here is uploaded to the daemon and can end up
# in a layer or a build cache.
.env
.env.*
!.env.example
config/
